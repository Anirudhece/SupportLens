{
  "name": "supportlens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n chroma,backend,frontend \"npm run dev:chroma\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:chroma": "chroma run --path .local/chroma --host 127.0.0.1 --port 8000",
    "test": "npm run test --workspace backend",
    "test:integration:local": "npm run test:local --workspace backend",
    "test:integration:cloud": "npm run test:cloud --workspace backend",
    "build": "npm run build --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "10.0.5"
  }
}
